NODE_ENV=development
PORT=4001

# Local docker-compose Mongo (separate container/port from Provisio's local Mongo,
# so both projects can run side by side without colliding)
MONGODB_URI=mongodb://localhost:27018/claritas

# Frontend origin allowed to make requests (CORS + Socket.io)
CLIENT_ORIGIN=http://localhost:5174

# Absolute path to the Playwright e2e suite this app drives. In local dev this
# points at the sibling Provisio checkout; in production a copy of that suite
# is bundled into this repo instead (see server/e2e-suite/).
PROVISIO_E2E_PATH=C:\workspace\provisio\e2e
