NODE_ENV=development
PORT=4001

# Local docker-compose Mongo (separate container/port from Provisio's local Mongo,
# so both projects can run side by side without colliding)
MONGODB_URI=mongodb://localhost:27018/claritas

# Frontend origin allowed to make requests (CORS + Socket.io)
CLIENT_ORIGIN=http://localhost:5174

# Absolute path to the Playwright e2e suite this app drives. In local dev this
# points at the sibling Provisio checkout; in production a copy of that suite
# is bundled into this repo instead (see server/e2e-suite/).
PROVISIO_E2E_PATH=C:\workspace\provisio\e2e

# Pre-flight health-check targets, probed before a run starts. Blank means
# that environment's check is skipped rather than treated as a failure.
PROVISIO_LOCAL_HEALTH_URL=http://localhost:4000/api/health
PROVISIO_LIVE_HEALTH_URL=https://provisio-api.onrender.com/api/health
HEALTH_TIMEOUT_MS=8000

# --- Optional: emailing scheduled-run reports -------------------------------
# Any SMTP provider works. Two common choices:
#   Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com,
#          SMTP_PASS=<16-character app password, not your normal password>
#   Resend: SMTP_HOST=smtp.resend.com, SMTP_PORT=587, SMTP_USER=resend,
#          SMTP_PASS=<your Resend API key>
# Leave these unset and the app still runs schedules — it just records each
# report email as skipped and says so in the UI.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# The "from" address on report emails. Defaults to SMTP_USER when blank.
MAIL_FROM=
# This API's own public URL, used to link the full report inside emails.
PUBLIC_URL=http://localhost:4001
